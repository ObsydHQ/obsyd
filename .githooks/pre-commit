#!/bin/sh
# Obsyd pre-commit: refuse to stage key material.
#
# The repo's one real secret is the throwaway testnet treasury key inside
# frontend/wallet/scripts/pool.json (gitignored, regenerated by
# provision-pool.mjs). This hook catches it being force-added, plus the general
# case of a Stellar secret seed or a private key block sneaking into a commit.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip deliberately (rare, and only for a false positive):  git commit --no-verify

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail() {
  echo ""
  echo "  ✗ $1"
  echo "    Obsyd never commits key material. See SECURITY.md."
  echo ""
  exit 1
}

# pool.json is ignored, so it only reaches here via `git add -f`.
case "
$staged
" in
  *"/pool.json"*|*"pool.json"*)
    fail "pool.json is staged — it contains the demo treasury secret key"
    ;;
esac

# Stricter than a substring match: an S-prefixed 56-character strkey, or a PEM
# header. G…/C… addresses are public and are not flagged.
if git diff --cached -U0 | grep -qE 'S[A-Z2-7]{55}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  fail "a Stellar secret seed or private key block appears in the staged diff"
fi

exit 0
