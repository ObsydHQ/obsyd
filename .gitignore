# dependencies
node_modules/
.next/
out/
dist/
build/

# rust: Cargo.lock is committed (it pins ed25519-dalek for the SDK's testutils),
# build artifacts are not.
contracts/target/

# soroban-sdk writes a ledger snapshot per test run. They are derived from
# test.rs, so they would churn on every contract change.
contracts/**/test_snapshots/

# env & secrets
.env
.env.local
.env.*.local

# Generated demo-pool config — contains a throwaway testnet treasury SECRET KEY.
# Recreated locally by `node frontend/wallet/scripts/provision-pool.mjs`. Never commit.
frontend/wallet/scripts/pool.json

# logs
*.log
npm-debug.log*

# ts/state
tsconfig.tsbuildinfo
.next_build

# local db / storage
*.sqlite
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# local cache
.cache/
coverage/

# Vendored reference clone (study only — NOT part of the shipped Obsyd codebase)
.reference/

# Local brand scratch: the org avatar is uploaded to GitHub, it is not repo content
obsyd-org-avatar.png
vibe_images/
