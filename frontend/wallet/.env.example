# Obsyd — environment template. Copy to .env.local (gitignored) and adjust.
# Everything here is NEXT_PUBLIC_* on purpose: this app has no server-only
# secrets, because it never signs anything.

# Which Stellar network the wallet talks to: "testnet" (default) or "public".
NEXT_PUBLIC_NETWORK=testnet

# SDF endpoints. The defaults match NEXT_PUBLIC_NETWORK=testnet.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Soroswap AMM used by the swap screen. These are the live testnet deployments;
# mainnet has different addresses and must be set explicitly.
NEXT_PUBLIC_SOROSWAP_FACTORY=CDP3HMUH6SMS3S7NPGNDJLULCOXXEPSHY4JKUKMBNQMATHDHWXRRJTBY
NEXT_PUBLIC_SOROSWAP_ROUTER=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD

# Reserved for the on-chain passkey signer (SECURITY.md "Open items"): the
# deployed obsyd_factory address and the obsyd_account WASM hash. Nothing reads
# them yet — they exist so a deployment is a config change, not a code change.
NEXT_PUBLIC_OBSYD_FACTORY=
NEXT_PUBLIC_OBSYD_ACCOUNT_WASM=

# The demo treasury key is NOT an environment variable. It lives in
# frontend/wallet/scripts/pool.json, produced by scripts/provision-pool.mjs and
# gitignored; regenerate it rather than pasting one anywhere.
